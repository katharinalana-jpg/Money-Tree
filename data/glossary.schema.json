{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portemonnaie.finance/data/glossary.schema.json",
  "title": "Portemonnaie glossary (PRD 7.3)",
  "type": "object",
  "required": ["meta", "terms"],
  "additionalProperties": false,
  "properties": {
    "meta": { "type": "object", "additionalProperties": true },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "term_de", "term_en", "aliases_de", "definition_de", "why_de", "example_de", "definition_en", "why_en", "example_en", "relatedIds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "term_de": { "type": "string", "minLength": 2 },
          "term_en": { "type": "string" },
          "aliases_de": { "type": "array", "items": { "type": "string" } },
          "definition_de": { "type": "string", "minLength": 10 },
          "why_de": { "type": "string", "minLength": 10 },
          "example_de": { "type": ["string", "null"] },
          "definition_en": { "type": "string" },
          "why_en": { "type": "string" },
          "example_en": { "type": ["string", "null"] },
          "relatedIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" } },
          "methodUrl": { "type": ["string", "null"], "pattern": "^https://" }
        }
      }
    }
  }
}
