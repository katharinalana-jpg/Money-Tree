{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portemonnaie.finance/data/sdgs.schema.json",
  "title": "Portemonnaie SDGs (PRD 7.4)",
  "type": "object",
  "required": ["meta", "sdgs"],
  "additionalProperties": false,
  "properties": {
    "meta": { "type": "object", "additionalProperties": true },
    "sdgs": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": ["id", "title_de", "title_en", "hover_de", "colorToken", "themes_de"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 17 },
          "title_de": { "type": "string", "minLength": 3 },
          "title_en": { "type": "string" },
          "hover_de": { "type": "string", "minLength": 3 },
          "colorToken": { "type": "string", "pattern": "^sdg-(0[1-9]|1[0-7])$" },
          "themes_de": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
