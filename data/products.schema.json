{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portemonnaie.finance/data/products.schema.json",
  "title": "Portemonnaie products (PRD 7.2, scores per decision 12.09.2026 on conflict 2)",
  "type": "object",
  "required": ["meta", "products"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "generated", "disclaimer"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string" },
        "generated": { "type": "string" },
        "disclaimer": { "type": "string", "minLength": 20 },
        "dataNote": { "type": "string" }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "score": {
      "type": ["object", "null"],
      "required": ["value", "source", "asOf"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 10 },
        "source": { "type": "string", "minLength": 2 },
        "method": { "type": ["string", "null"] },
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" }
      }
    },
    "product": {
      "type": "object",
      "required": ["id", "isin", "name", "provider", "type", "subtype", "region", "currency", "ter", "sri", "distribution", "inceptionDate", "fundSizeMeur", "holdingsCount", "topHoldings", "scores", "sdgTags", "exclusions", "description_de", "description_en", "kidUrl", "themes_de", "themes_en", "asOf"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "isin": { "type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
        "name": { "type": "string", "minLength": 2 },
        "provider": { "type": ["string", "null"] },
        "type": { "type": "string", "enum": ["etf", "stock", "bond"] },
        "subtype": { "type": "string", "enum": ["equity_world", "equity_theme", "green_bond", "single_stock"] },
        "region": { "type": "string", "enum": ["world", "europe", "emerging", "austria", "us"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "ter": { "type": ["number", "null"], "minimum": 0, "maximum": 0.1 },
        "sri": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 },
        "distribution": { "type": ["string", "null"], "enum": ["accumulating", "distributing", null] },
        "inceptionDate": { "type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$" },
        "fundSizeMeur": { "type": ["number", "null"], "minimum": 0 },
        "fundSizeCurrency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "holdingsCount": { "type": ["integer", "null"], "minimum": 1 },
        "topHoldings": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
        "scores": {
          "type": "object",
          "required": ["sustainability", "gender", "radar"],
          "additionalProperties": false,
          "properties": {
            "sustainability": { "$ref": "#/$defs/score" },
            "gender": { "$ref": "#/$defs/score" },
            "radar": {
              "type": "object",
              "required": ["climate", "social", "governance", "gender", "biodiversity", "transparency"],
              "additionalProperties": false,
              "properties": {
                "climate": { "$ref": "#/$defs/score" },
                "social": { "$ref": "#/$defs/score" },
                "governance": { "$ref": "#/$defs/score" },
                "gender": { "$ref": "#/$defs/score" },
                "biodiversity": { "$ref": "#/$defs/score" },
                "transparency": { "$ref": "#/$defs/score" }
              }
            }
          }
        },
        "sdgTags": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 17 } },
        "exclusions": { "type": "array", "items": { "type": "string" } },
        "description_de": { "type": "string" },
        "description_en": { "type": "string" },
        "kidUrl": { "type": ["string", "null"], "pattern": "^https://" },
        "themes_de": { "type": "array", "items": { "type": "string" } },
        "themes_en": { "type": "array", "items": { "type": "string" } },
        "asOf": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
